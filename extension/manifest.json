{
  "manifest_version": 3,
  "name": "Resume Master",
  "version": "1.0.0",
  "description": "Capture the job you're viewing, and fill the application you signed in to reach. You review every answer and submit it yourself.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "privacy_policy_url": "https://resumemaster.one/privacy",
  "host_permissions": [
    "https://resumemaster.one/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "capture-job": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Capture the current job into Resume Master"
    },
    "fill-gated-application": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Fill the application you signed in to reach"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
