    "/v1/resumes/enhance": {
      "post": {
        "summary": "[metered] POST /v1/resumes/enhance",
        "security": [
          {
            "clientToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnhanceRequest"
