      "examples": [{ "say": "rotate page 1 left", "args": { "page": 1, "dir": "left" } }, { "say": "rotate page 2", "args": { "page": 2 } }, { "say": "turn this page right", "args": { "dir": "right" } }] },
    { "intent": "move_page", "site": "rm", "tier": "T1", "calls": "movePage",
