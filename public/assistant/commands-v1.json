{
  "about": "D190 · the command vocabulary for Tiny (the PDF-tools site, site rm) and Ask draft (draft, site draft). ONE file for both sites, mirrored byte-identical into resume-master at public/assistant/commands-v1.json. Each row: intent · site · tier (T1 action / T2 from the site's data / ask = asks back / T3 = the model, only on an explicit request) · patterns (shared/assistantEngine.js grammar) · calls (the handler — the SAME function the toolbar or button calls) · confirm (asked first) · examples (run by test/d190VocabularyExamplesPass). Rows are tried in order: specific before general. Adding a command = one row.",
  "version": 1,
  "commands": [
    { "intent": "help", "site": "both", "tier": "T1", "calls": "help",
      "patterns": ["help", "what can you do", "what can i (say|ask|type)", "commands"],
      "examples": [{ "say": "what can you do?", "args": {} }, { "say": "help", "args": {} }] },
    { "intent": "undo", "site": "both", "tier": "T1", "calls": "undo",
      "patterns": ["undo[ (that|it|this|the last change|my last change)]", "take (that|it) back", "revert (that|it)"],
      "examples": [{ "say": "undo", "args": {} }, { "say": "undo that", "args": {} }] },
    { "intent": "redo", "site": "rm", "tier": "T1", "calls": "redo",
      "patterns": ["redo[ (that|it)]"],
      "examples": [{ "say": "redo", "args": {} }] },
    { "intent": "ambiguous", "site": "both", "tier": "ask", "reply": "What should I change? Say it like “replace 2023 with 2024” or “make line 3 bold”.",
      "patterns": ["(fix|change|edit|improve|update|correct) (this|it|that|this one)", "make it better", "do it", "do something", "fix", "change", "edit"],
      "examples": [{ "say": "fix this", "args": {} }, { "say": "make it better", "args": {} }] },

    { "intent": "replace_text", "site": "rm", "tier": "T1", "calls": "replaceText",
      "patterns": [
        "(replace|change|swap|switch) line {line:int} on page {page:int} (with|to|for|into) {new}",
        "(replace|change|swap|switch) line {line:int} (with|to|for|into) {new}",
        "(replace|change|swap|switch|update) {old} (with|to|for|into|by|as) {new} (on|in|at) line {line:int} (on|of) page {page:int}",
        "(rewrite|write|turn|make) {old} (as|into) {new} (on|in|at) line {line:int} (on|of) page {page:int}",
        "(replace|change|swap|switch|update) {old} (with|to|for|into|by|as) {new} (on|in) page {page:int}[ line {line:int}]",
        "(rewrite|write|turn|make) {old} (as|into) {new} (on|in) page {page:int}[ line {line:int}]",
        "(replace|change|swap|switch|update) {old} (with|to|for|into|by|as) {new} (on|in|at) line {line:int}",
        "(rewrite|write|turn|make) {old} (as|into) {new} (on|in|at) line {line:int}",
        "(replace|change|swap|switch|update) {old} (with|to|for|into|by|as) {new}",
        "(rewrite|write|turn|make) {old} (as|into) {new}",
        "(replace|change|swap|switch) {old} on line {line:int} (with|to|for|into) {new}"
      ],
      "examples": [
        { "say": "replace 10,700,942 with 10,800,000 on line 3", "args": { "old": "10,700,942", "new": "10,800,000", "line": 3 } },
        { "say": "change \"Senior Analyst\" to \"Lead Analyst\"", "args": { "old": "Senior Analyst", "new": "Lead Analyst" } },
        { "say": "swap 2023 for 2024 on page 2", "args": { "old": "2023", "new": "2024", "page": 2 } },
        { "say": "replace Boston with New York on line 4 of page 1", "args": { "old": "Boston", "new": "New York", "line": 4, "page": 1 } },
        { "say": "replace line 2 with Data Engineer", "args": { "line": 2, "new": "Data Engineer" } },
        { "say": "please replace 2019 with 2020.", "args": { "old": "2019", "new": "2020" } },
        { "say": "rewrite letter as page", "args": { "old": "letter", "new": "page" } },
        { "say": "make Boston into New York", "args": { "old": "Boston", "new": "New York" } }
      ] },
    { "intent": "delete_page", "site": "rm", "tier": "T1", "calls": "deletePage", "confirm": "Delete page {page}? Undo brings it back.",
      "patterns": ["(delete|remove) page {page:int}", "(delete|remove) (this|the current) page"],
      "examples": [{ "say": "delete page 2", "args": { "page": 2 } }, { "say": "remove this page", "args": {} }] },
    { "intent": "delete_all_pages", "site": "rm", "tier": "T1", "calls": "deleteAllPages", "confirm": "Are you sure? A PDF needs at least one page — this keeps page 1 and deletes the rest.",
      "patterns": ["(delete|remove) (all|every)[ the] pages", "(delete|remove) all pages but (the first|page 1)"],
