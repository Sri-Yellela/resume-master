      "examples": [{ "say": "make line 1 size 14", "args": { "target": "line 1", "size": "14" } }, { "say": "set the header to size 18", "args": { "target": "the header", "size": "18" } }, { "say": "make the name bigger", "args": { "target": "the name" } }] },
    { "intent": "convert", "site": "rm", "tier": "T1", "calls": "convert",
