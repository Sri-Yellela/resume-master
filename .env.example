PORT=3001
APP_BASE_URL=http://localhost:3001
SESSION_SECRET=replace-with-a-long-random-secret
PASSWORD_RESET_SECRET=replace-with-a-long-random-secret
COOKIE_ENCRYPTION_KEY=replace-with-64-hex-chars

# Google OAuth sign-in / integration linking
# Google Cloud Console authorized redirect URI must exactly match this value.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# LinkedIn OpenID Connect sign-in / integration linking
# LinkedIn app authorized redirect URI must exactly match this value.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3001/auth/linkedin/callback

# GitHub OAuth sign-in / integration linking
# GitHub OAuth app callback URL must exactly match this value.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# THEIRSTACK_API_KEY is used only by the standalone provider evaluation harness
# (scripts/providerEval/) — not wired into the live pipeline. Absent: skipped gracefully.
THEIRSTACK_API_KEY=

# JOBO_API_KEY powers BOTH the live Jobo feed sync (services/jobs/sources/jobo.js, cron-only,
# 04:00 ET) and the standalone provider eval harness. Absent: the live sync logs and skips.
JOBO_API_KEY=
# Unset (default): Jobo's first backfill run is bounded to one small batch (credit-safe).
# Set to 1: runs the full unbounded stable_scan backfill instead — this consumes Jobo wallet
# credits. Only matters on the very first run; ignored once backfill has completed.
JOBO_FULL_BACKFILL=

# ── Chrome Web Store publishing (scripts/publishExtension.mjs) ────────────────
# Only needed to upload/publish the extension. `--dry-run` runs the full preflight
# without any of these. The refresh token must belong to the account that OWNS the
# store item; treat it like a password.
#
#   1. Google Cloud console: enable the Chrome Web Store API, create an OAuth client
#      of type "Desktop app".
#   2. Authorise it once against scope https://www.googleapis.com/auth/chromewebstore
#      and keep the refresh token it returns.
#   3. CWS_ITEM_ID is the 32-character id in the dashboard URL for the published item.
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
CWS_ITEM_ID=

# ── Free-tier routing for PUBLIC model traffic (services/modelCall.js) ────────
# Routes the call sites that operate on PUBLIC data — enrich_job (60.2% of all spend),
# classify_job, import_job — to a free-tier provider. Every call site that touches CANDIDATE
# data stays on Anthropic and CANNOT be routed by these variables; the split is by whose data
# a call sends, not by a filter over the payload. See shared/modelProviders.js.
#
# ALL FOUR ABSENT (the default) = everything on Anthropic, and that is not a warning.
# ENRICH_PROVIDER set with its key ABSENT = a LOUD warning and a fallback to Anthropic — never
# a silent skip.
#
# ⚠ Free tiers are commonly funded by your prompts, and Groq does not state its policy either
# way on a public page. The PUBLIC-only rule is what keeps that clean: the only thing such a
# tier can learn from this app is the text of job adverts that were already on the open web.
#
# ⚠ Rate limits, not price, are the constraint: Groq is 30 req/min, so a full 1302-row
# enrichment pass takes ~43 minutes. The transport paces itself to this automatically.
#
# ⛔ Do NOT switch ENRICH_PROVIDER on a deployment before running
#    scripts/al1ProviderQualityDiff.mjs — an 8B model may extract worse than Haiku, and
#    skills_json feeds company_technographics and the ATS scorer. See docs/al1-provider-routing.md.
ENRICH_PROVIDER=
# Must be one of the PINNED ids in shared/modelProviders.js. Anything else THROWS rather than
# falling back, because a quiet fallback means the free tier stops being used and the bill
# returns with every dashboard still green. Leave blank to use the provider's default.
ENRICH_MODEL=
GROQ_API_KEY=
GOOGLE_API_KEY=
